# ==============================================================================
# GORO S2JB - Environment Configuration Template (.env)
# Salin file ini menjadi .env sebelum menjalankan aplikasi:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Deployment Docker Compose (Zero-Host Setup)
#    Digunakan saat menjalankan: docker compose up -d --build
# ------------------------------------------------------------------------------
# Kredensial untuk kontainer PostgreSQL (goro-postgres)
POSTGRES_USER="goro_admin"
POSTGRES_PASSWORD="goro_secret_2026"
POSTGRES_DB="goro_s2jb"

# ------------------------------------------------------------------------------
# 2. Konfigurasi Deployment Native Lokal (macOS / Linux / Windows)
#    Digunakan saat menjalankan: npm run start:all
# ------------------------------------------------------------------------------
# Basis data PostgreSQL lokal di port 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goro_s2jb?schema=public"

# Redis broker lokal di port 6379
REDIS_URL="redis://localhost:6379"

# Direktori penyimpanan unggahan bukti ulasan
STORAGE_PATH="./uploads"

# Endpoint microservice OCR Engine (Rust Native) di port 8001
OCR_SERVICE_URL="http://127.0.0.1:8001"

# ------------------------------------------------------------------------------
# 3. Kunci Keamanan & URL Akses (Berlaku untuk Docker & Native)
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXTAUTH_SECRET="goro-s2jb-secret-key-2026-production-ready"
NEXTAUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="goro-s2jb-command-center-secret-key-pln-2026-production-secured-32chars"
BETTER_AUTH_URL="http://localhost:3000"

