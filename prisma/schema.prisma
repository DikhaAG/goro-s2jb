// Prisma schema for GORO S2JB 2026

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PETUGAS_LAPANGAN
  PEGAWAI
  MANAGER
  SUPER_ADMIN
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum OcrProcessingStatus {
  QUEUED
  DOWNLOADING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  displayUsername String?
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  passwordHash    String?
  role            Role      @default(PETUGAS_LAPANGAN)
  isActive        Boolean   @default(true)
  up3Id           String?
  ulpId           String?
  up3             UP3?      @relation(fields: [up3Id], references: [id])
  ulp             ULP?      @relation(fields: [ulpId], references: [id])
  
  sessions        Session[]
  accounts        Account[]
  submittedReviews RatingReview[] @relation("SubmittedReviews")
  verifiedReviews  RatingReview[] @relation("VerifiedReviews")
  migrations       MigrationBatch[]
  auditLogs        AuditLog[]
  verifiedTrainingSamples OcrTrainingSample[] @relation("VerifiedTrainingSamples")
  trainedOcrModels        OcrModelRegistry[]  @relation("TrainedOcrModels")
  activatedOcrModels      OcrModelRegistry[]  @relation("ActivatedOcrModels")
  createdTrainingJobs     OcrTrainingJob[]    @relation("CreatedTrainingJobs")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UP3 {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  ulps      ULP[]
  reviews   RatingReview[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ULP {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  up3Id     String
  up3       UP3      @relation(fields: [up3Id], references: [id])
  reviews   RatingReview[]
  targets   TargetMaster[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppVersion {
  id        String   @id @default(cuid())
  version   String   @unique
  isActive  Boolean  @default(true)
  reviews   RatingReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TargetMaster {
  id               String   @id @default(cuid())
  ulpId            String
  ulp              ULP      @relation(fields: [ulpId], references: [id])
  targetDate       DateTime
  dailyTarget      Float    @default(0)
  cumulativeTarget Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ulpId, targetDate])
  @@index([targetDate])
  @@index([ulpId])
}

model RatingReview {
  id                    String           @id @default(cuid())
  timestamp             DateTime         @default(now()) // Column 1
  up3Id                 String                            // Column 2
  ulpId                 String                            // Column 3
  playstoreReviewerName String                            // Column 4
  entryDate             DateTime                          // Column 5
  evidenceImagePath     String                            // Column 6
  evidenceImageHash     String?                           // Perceptual Hash (pHash 64-bit)
  appVersionId          String                            // Column 7
  originalReviewerName  String?                           // Column 8
  reviewerCategory      String           @default("Pelanggan") // Column 9
  fieldNotes            String?                           // Column 10
  isDuplicate           Boolean          @default(false)  // Column 11
  duplicateOfId         String?                           // Soft-flagging reference
  validationStatus      ValidationStatus @default(PENDING) // Column 12
  ocrStatus             OcrProcessingStatus @default(QUEUED)
  confidenceScore       Float?                            // 0.0 - 100.0%
  extractedOcrText      String?          @db.Text
  reviewRemarks         String?                           // Column 13
  
  submittedById         String?
  verifiedById          String?
  verifiedAt            DateTime?

  up3                   UP3              @relation(fields: [up3Id], references: [id])
  ulp                   ULP              @relation(fields: [ulpId], references: [id])
  appVersion            AppVersion       @relation(fields: [appVersionId], references: [id])
  duplicateOf           RatingReview?    @relation("ReviewDuplicates", fields: [duplicateOfId], references: [id])
  duplicateChildren     RatingReview[]   @relation("ReviewDuplicates")
  submittedBy           User?            @relation("SubmittedReviews", fields: [submittedById], references: [id])
  verifiedBy            User?            @relation("VerifiedReviews", fields: [verifiedById], references: [id])
  trainingSamples       OcrTrainingSample[]

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([timestamp])
  @@index([entryDate])
  @@index([ulpId])
  @@index([validationStatus])
  @@index([ocrStatus])
  @@index([evidenceImageHash])
  @@index([isDuplicate])
}

enum MigrationStatus {
  PENDING
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model MigrationBatch {
  id               String              @id @default(cuid())
  fileName         String
  fileSize         Int
  filePath         String?
  targetType       String              // "FORM_RESPONSES_RAW" | "HISTORICAL_REPORTS"
  totalRows        Int                 @default(0)
  processedRows    Int                 @default(0)
  failedRows       Int                 @default(0)
  lastProcessedRow Int                 @default(0)
  status           MigrationStatus     @default(PENDING)
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  uploadedById     String?
  uploadedBy       User?               @relation(fields: [uploadedById], references: [id])
  errors           MigrationErrorLog[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([uploadedById, status])
  @@index([createdAt])
}

model MigrationErrorLog {
  id          String         @id @default(cuid())
  batchId     String
  batch       MigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber   Int
  rawRowData  String?        @db.Text
  errorReason String
  createdAt   DateTime       @default(now())

  @@index([batchId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum OcrSampleSource {
  IMPORT_SPREADSHEET
  TRIAGE_VALIDATION
  CURATIVE_REVIEW
  MANUAL_CURATION
}

enum OcrSampleInclusion {
  APPROVED_FOR_TRAIN
  PENDING_REVIEW
  EXCLUDED
}

enum OcrModelStatus {
  STAGING
  ACTIVE
  ARCHIVED
  REJECTED
}

enum OcrTrainingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model OcrTrainingSample {
  id              String             @id @default(cuid())
  reviewId        String?
  review          RatingReview?      @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  imagePath       String
  imageHash       String?
  groundTruthText String             @db.Text
  reviewerName    String?
  rawOcrText      String?            @db.Text
  confidenceScore Float?
  source          OcrSampleSource    @default(TRIAGE_VALIDATION)
  inclusion       OcrSampleInclusion @default(APPROVED_FOR_TRAIN)
  exclusionReason String?
  cropBox         Json?
  verifiedById    String?
  verifiedBy      User?              @relation("VerifiedTrainingSamples", fields: [verifiedById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([inclusion])
  @@index([source])
  @@index([reviewId])
  @@index([imageHash])
  @@index([createdAt])
}

model OcrModelRegistry {
  id                   String             @id @default(cuid())
  version              String             @unique
  name                 String
  description          String?
  artifactPath         String
  architecture         String             @default("CRNN_PYTORCH")
  status               OcrModelStatus     @default(STAGING)
  cerScore             Float?
  werScore             Float?
  accuracyScore        Float?
  trainingSamplesCount Int                @default(0)
  epochsTrained        Int                @default(0)
  durationSeconds      Int                @default(0)
  metadata             Json?
  trainedById          String?
  trainedBy            User?              @relation("TrainedOcrModels", fields: [trainedById], references: [id])
  activatedById        String?
  activatedBy          User?              @relation("ActivatedOcrModels", fields: [activatedById], references: [id])
  activatedAt          DateTime?
  trainingJobs         OcrTrainingJob[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@index([version])
  @@index([createdAt])
}

model OcrTrainingJob {
  id                 String               @id @default(cuid())
  status             OcrTrainingJobStatus @default(PENDING)
  triggerType        String               // "MANUAL" | "THRESHOLD" | "SCHEDULED_CRON"
  modelTargetVersion String
  datasetSize        Int                  @default(0)
  currentEpoch       Int                  @default(0)
  totalEpochs        Int                  @default(10)
  currentLoss        Float?
  logs               Json?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  durationSeconds    Int?
  createdById        String?
  createdBy          User?                @relation("CreatedTrainingJobs", fields: [createdById], references: [id])
  modelRegistryId    String?
  modelRegistry      OcrModelRegistry?    @relation(fields: [modelRegistryId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
  @@index([triggerType])
  @@index([createdAt])
}


